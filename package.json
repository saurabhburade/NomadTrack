{
  "name": "nomadtrack",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first offline travel tracker for React Native.",
  "main": "index.ts",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start": "expo start --dev-client --scheme exp+travel-nri-tracker",
    "start:go": "expo start --go --scheme exp+travel-nri-tracker",
    "start:dev-client": "expo start --dev-client --scheme exp+travel-nri-tracker",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --device --configuration Release",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level moderate",
    "security:lock": "pnpm install --lockfile-only --ignore-scripts && pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ui": "0.2.0-beta.9",
    "@react-navigation/bottom-tabs": "7.16.1",
    "@react-navigation/native": "7.2.4",
    "@react-navigation/native-stack": "7.15.1",
    "@rn-primitives/slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.2.1",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-background-task": "~1.0.10",
    "expo-blur": "^55.0.14",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-font": "^55.0.8",
    "expo-glass-effect": "~0.1.10",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "1.16.0",
    "nativewind": "4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-css-interop": "0.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10"
    },
    "patchedDependencies": {
      "expo-constants@18.0.13": "patches/expo-constants@18.0.13.patch",
      "@expo/ui@0.2.0-beta.9": "patches/@expo__ui@0.2.0-beta.9.patch"
    }
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
