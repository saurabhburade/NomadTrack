{
  "name": "nomadtrack",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first offline travel tracker for React Native.",
  "main": "index.ts",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start": "expo start --dev-client --scheme exp+travel-nri-tracker",
    "start:go": "expo start --go --scheme exp+travel-nri-tracker",
    "start:dev-client": "expo start --dev-client --scheme exp+travel-nri-tracker",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "node scripts/ios-release-with-provisioning.mjs",
    "prepare": "husky",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "commitlint": "commitlint --verbose",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level moderate",
    "security:lock": "pnpm install --frozen-lockfile --ignore-scripts && pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ui": "0.2.0-beta.9",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@rn-primitives/slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.2.1",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "1.16.0",
    "nativewind": "4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-css-interop": "0.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~57.0.9",
    "husky": "9.1.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
